# ============================================================
# Watanya Store API - environment
# Copy to .env and adjust. Never commit real secrets.
# ============================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public URL of this API (used for CORS + image URLs)
API_PUBLIC_URL=http://localhost:4000
# URL of the frontend (CORS allow-list)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:4000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=watanya_app
DB_PASSWORD=1z2x3c4v
DB_NAME=watanya
DB_CONNECTION_LIMIT=10

# --- JWT ---
# CHANGE THESE before deploying. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=210886424c548f8812123f0b4cc106e7385bc6de7b8ee0e0ed9d5896cf8c903c3aa72ef89a5a834f5d412aa03acd2e6b
JWT_REFRESH_SECRET=d107ac4be1799bb258be0196d0b409b98c0a0b61c1888bbeaa612ea99613114b1bc58cf9a243dd972c72ab06af90a6be
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_DAYS=30

# --- Store config ---
CURRENCY=SAR
FREE_SHIPPING_THRESHOLD=200
SHIPPING_FLAT_RATE=25
TAX_RATE=0.15
MAX_PAGE_SIZE=60
DEFAULT_PAGE_SIZE=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20


# Local development only - the smoke suite needs more than 20 auth calls per 15 min
RATE_LIMIT_DISABLED=true

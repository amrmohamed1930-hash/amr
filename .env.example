# ============================================================
# Watanya Store API - environment
# Copy to .env and adjust. Never commit real secrets.
# ============================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Public URL of this API (used for CORS + image URLs)
API_PUBLIC_URL=http://localhost:4000
# URL of the frontend (CORS allow-list)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:4000

# --- MySQL ---
# The runtime account the API connects with. Keep it restricted to this one
# database - the setup script grants exactly these privileges.
DB_HOST=localhost
DB_PORT=3306
DB_USER=watanya_app
DB_PASSWORD=change_me
DB_NAME=watanya
DB_CONNECTION_LIMIT=10

# --- MySQL (setup only) ---
# `npm run db:setup` creates the database and applies the schema, which needs
# CREATE/DROP rights. Point these at an admin account; they are NOT used by the
# running API. Defaults to DB_USER / DB_PASSWORD if unset.
SETUP_DB_USER=root
SETUP_DB_PASSWORD=change_me

# --- JWT ---
# CHANGE THESE before deploying. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev_only_access_secret_change_me_8f2a1c9e4b7d
JWT_REFRESH_SECRET=dev_only_refresh_secret_change_me_3e5b7d1a
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

# --- Store config ---
CURRENCY=SAR
FREE_SHIPPING_THRESHOLD=200
SHIPPING_FLAT_RATE=25
TAX_RATE=0.15
MAX_PAGE_SIZE=60
DEFAULT_PAGE_SIZE=12

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Set to true to disable all rate limiting. Local dev / load testing ONLY - the
# smoke suite makes more than 20 auth calls in a row and would otherwise 429.
# Never set this in production.
RATE_LIMIT_DISABLED=false

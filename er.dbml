// ==============================================
// Watanya Finance - ER Diagram (DBML)
// Paste into https://dbdiagram.io
// You can drag the boxes to arrange them nicely.
// ==============================================

Table customers {
  id            int [pk, increment]
  full_name     varchar(120)
  email         varchar(190) [unique]
  phone         varchar(20)  [unique]
  password_hash varchar(255)
  country       varchar(60)  [default: 'السعودية']
  city          varchar(60)
  district      varchar(90)
  street        varchar(190)
  building      varchar(60)
  is_active     tinyint      [default: 1]
  created_at    datetime     [default: `now()`]
  updated_at    datetime     [default: `now()`]
}

Table admins {
  id            int [pk, increment]
  full_name     varchar(120)
  email         varchar(190) [unique]
  phone         varchar(20)  [unique]
  password_hash varchar(255)
  is_active     tinyint      [default: 1]
  created_at    datetime     [default: `now()`]
  updated_at    datetime     [default: `now()`]
}

Table categories {
  id         int [pk, increment]
  parent_id  int    // subcategory of (no relation shown)
  name_ar    varchar(120)
  name_en    varchar(120)
  slug       varchar(140) [unique]
  image_path varchar(255)
  sort_order int          [default: 0]
  is_active  tinyint      [default: 1]
}

Table brands {
  id        int [pk, increment]
  name_ar   varchar(120)
  name_en   varchar(120)
  slug      varchar(140) [unique]
  logo_path varchar(255)
  is_active tinyint [default: 1]
}

Table products {
  id             int [pk, increment]
  brand_id       int [ref: > brands.id]
  name_ar        varchar(255)
  name_en        varchar(255)
  slug           varchar(180) [unique]
  description    text
  base_price     decimal(12,2)
  sale_price     decimal(12,2)
  currency       char(3)      [default: 'SAR']
  rating_avg     decimal(3,2) [default: 0]
  rating_count   int          [default: 0]
  stock_quantity int          [default: 0]
  is_loanable    tinyint      [default: 0]
  is_featured    tinyint      [default: 0]
  is_active      tinyint      [default: 1]
  created_at     datetime     [default: `now()`]
  updated_at     datetime     [default: `now()`]
}

// Junction: product <-> category (many to many)
Table product_categories {
  product_id  int [ref: > products.id]
  category_id int [ref: > categories.id]

  indexes {
    (product_id, category_id) [pk]
  }
}

Table product_images {
  id         int [pk, increment]
  product_id int [ref: > products.id]
  image_path varchar(255)
  is_primary tinyint [default: 0]
  sort_order int     [default: 0]
}

Table price_history {
  id         int [pk, increment]
  product_id int [ref: > products.id]
  old_price  decimal(12,2)
  new_price  decimal(12,2)
  changed_by int [ref: > admins.id]   // admin who changed it
  reason     varchar(190)
  changed_at datetime [default: `now()`]
}

Table cart_items {
  id          int [pk, increment]
  customer_id int [ref: > customers.id]
  created_at  datetime [default: `now()`]
  updated_at  datetime [default: `now()`]

  indexes {
    (customer_id) [unique]
  }
}

Table cart_product {
  id           int [pk, increment]
  cart_item_id int [ref: > cart_items.id]
  product_id   int [ref: > products.id]
  amount       int [default: 1]   // quantity
  price        decimal(12,2)      // unit price at add-time

  indexes {
    (cart_item_id, product_id) [unique]
  }
}